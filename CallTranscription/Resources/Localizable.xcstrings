    "consentDialog.bullet3": {
      "comment": "Third bullet point",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other regions require all parties to consent before recording (two-party or all-party consent)"
