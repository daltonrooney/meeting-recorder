    "config.validation.notDirectory": {
      "comment": "Not a directory error message (with %@ placeholder for path)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad existiert, ist aber kein Verzeichnis: %@"
