          }
        }
      }
    },
    "consentDialog.button.understand": {
      "comment": "I Understand button label",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I Understand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
