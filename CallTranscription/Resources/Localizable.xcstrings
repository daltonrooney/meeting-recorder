          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理解しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
