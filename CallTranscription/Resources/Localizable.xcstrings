      }
    },
    "error.postRecordingScriptTimeout.failureReason": {
      "comment": "Post-recording script timeout failure reason (with %.0f placeholder for seconds)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
