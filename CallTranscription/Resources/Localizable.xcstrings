    "consentDialog.bullet2": {
      "comment": "Second bullet point",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some regions require only one party's consent (one-party consent states)"
