        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden usar directorios del sistema: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'utiliser les répertoires système : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムディレクトリは使用できません：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
